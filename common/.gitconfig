[user]
	email = sean.tronsen@gmail.com
	name = Sean Tronsen
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = cat
[pull]
	rebase = false
[alias]
	diffc = diff --compact-summary
	parse = rev-parse --short
    # stolen from https://stackoverflow.com/questions/1057564/pretty-git-branch-graphs
    graph = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all

[credential]
	helper = cache --timeout=604800
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
